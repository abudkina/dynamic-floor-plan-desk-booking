{
  "name": "dynamic-floor-plan-desk-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Интерактивная SVG-карта офиса с бронированием столов",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node ./node_modules/playwright/cli.js test",
    "test:all": "npm test && npm run test:e2e",
    "screenshots": "node ./scripts/capture-screenshots.mjs",
    "lighthouse:check": "node ./scripts/lighthouse-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
